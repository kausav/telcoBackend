# Google / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PYDANTIC_AI_GEMINI_MODEL=gemini-3.8-flash

# Runtime state / MongoDB
# For Linux/systemd, use a writable persistent path such as:
# RUNTIME_DATA_DIR=/var/lib/ingenii/telcoBackend
RUNTIME_DATA_DIR=./runtime_data
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=telco_scenario_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_APP_NAME=telco-agentic-sdg
MONGODB_SCENARIOS_COLLECTION=scenarios
MONGODB_DRAFTS_COLLECTION=scenario_drafts
MONGODB_SCENARIO_VARIABLES_COLLECTION=scenario_variables
MONGODB_USER_VARIABLES_COLLECTION=scenario_user_variables
MONGODB_FEEDBACK_COLLECTION=scenario_feedback
# Behaviour packs: per-domain behaviour data, stored only in MongoDB (import behavior_packs.json)
MONGODB_BEHAVIOR_PACKS_COLLECTION=behavior_packs
BEHAVIOR_PACK_CACHE_SECONDS=60
# Optional domain vocabulary (business-term synonyms), MongoDB only (import domain_lexicon.json)
MONGODB_DOMAIN_LEXICON_COLLECTION=domain_lexicon
DOMAIN_LEXICON_CACHE_SECONDS=60
MONGODB_PROPOSALS_COLLECTION=scenario_proposals
MONGODB_CONVERSATIONS_COLLECTION=conversations
MONGODB_CHAT_MESSAGES_COLLECTION=chat_messages
# auto | disabled
DRAFT_TTL_SECONDS=86400

# HTTP
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# For production, set CORS_ALLOW_ORIGINS to the exact HTTPS frontend origins.
PORT=8000
WEB_CONCURRENCY=1
MAX_CSV_BYTES=10485760
# MongoDB collection containing uploaded industry/domain standard JSON documents.
MONGODB_INDUSTRY_SOURCES_COLLECTION=industry_source_documents
# Maximum uploaded standard JSON size in bytes (default 8 MiB).
INDUSTRY_SOURCE_MAX_JSON_BYTES=8388608
# Maximum number of source variables projected into the LLM prompt. This is only a prompt-size safeguard;
# final compilation evaluates the complete active MongoDB catalog.
JSON_SOURCE_LLM_CATALOG_LIMIT=1200
# Representative fields per relevant source model sent to Gemini during /scenario/propose.
# The complete MongoDB source catalog remains authoritative for deterministic compilation.
JSON_SOURCE_LLM_FIELDS_PER_MODEL=6
# Short-lived process cache for parsed MongoDB source catalogs. Source mutations invalidate it locally.
SOURCE_CATALOG_CACHE_TTL_SECONDS=60

# Schema breadth / quality
# Maximum executable variables per compiled schema. Raise this for very large standards catalogs.
# Total variables per proposal incl. DB variables (DB first, then ranked JSON variables)
SCHEMA_MAX_VARIABLES=60
# true = LLM picks relevant source resources once, locked in MongoDB per distinct input; false = no LLM at all
PROPOSE_LLM_ADVISOR=true
MONGODB_SELECTION_LOCKS_COLLECTION=scenario_selection_locks
# Legacy quality threshold for non-source candidate paths; JSON-source breadth uses the recall-first selector.
SCHEMA_MIN_VARIABLE_SCORE=42
