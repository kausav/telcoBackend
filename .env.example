# The service reads exactly these four values from the environment.
# Every other setting is a constant in config/constants.py (edit it there and redeploy).
# Never commit real values: on Cloud Run use Secret Manager or the service's environment settings.

# Gemini API key (secret).
GEMINI_API_KEY=

# MongoDB connection string (secret). Local development: mongodb://localhost:27017
MONGODB_URI=

# Database name. Empty uses the default in config/constants.py (telco_scenario_db).
MONGODB_DB_NAME=

# Static API token(s) (secret). Callers send "Authorization: Bearer <token>" or "X-API-Key: <token>".
# Comma-separate two tokens to rotate without downtime. Unset or empty = every protected request is refused.
# "off" switches authentication off (local development only). Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_STATIC_TOKENS=

# Single-container deployment only (Dockerfile.combined): the backend also serves the built web UI.
# Every VITE_* variable of the running service is handed to the page at run time (GET /runtime-config.js), so the same image can be
# configured per environment: VITE_API_HOST (use "same-origin"), VITE_API_TOKEN, VITE_DEFAULT_COUNTRY, VITE_PLATFORM_URL.
# VITE_API_TOKEN must be one of API_STATIC_TOKENS. These values are visible to anyone who loads the page, so protect the page itself
# (IAP / load balancer) if the data is not public. UI_API_TOKEN is still accepted as another name for VITE_API_TOKEN.
# UI_DIR (or STATIC_DIR) is where the built UI sits (default /app/ui); with no index.html there the server serves the API only.
VITE_API_TOKEN=
# UI_PAGE_PATHS: extra addresses that also show the UI (default /source). Comma-separated; API routes are never taken over.
