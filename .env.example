# Google / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PYDANTIC_AI_GEMINI_MODEL=gemini-3.8-flash

# Runtime state (created automatically)
RUNTIME_DATA_DIR=./runtime_data
REGISTRY_DB_PATH=./runtime_data/registry.db
DYNAMIC_SCENARIOS_DB=./runtime_data/dynamic_scenarios.db
CONVERSATION_DB_PATH=./runtime_data/conversations.db
DRAFT_TTL_SECONDS=86400

# HTTP
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_CSV_BYTES=10485760
