# Google / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PYDANTIC_AI_GEMINI_MODEL=gemini-3.8-flash

# Runtime state / MongoDB
# For Linux/systemd, use a writable persistent path such as:
# RUNTIME_DATA_DIR=/var/lib/ingenii/telcoBackend
RUNTIME_DATA_DIR=./runtime_data
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=telco_scenario_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_APP_NAME=telco-agentic-sdg
MONGODB_REGISTRY_ENTITIES_COLLECTION=registry_entities
MONGODB_REGISTRY_STANDARDS_COLLECTION=registry_standards
MONGODB_REGISTRY_META_COLLECTION=registry_meta
MONGODB_SCENARIOS_COLLECTION=scenarios
MONGODB_DRAFTS_COLLECTION=scenario_drafts
MONGODB_SCENARIO_VARIABLES_COLLECTION=scenario_variables
MONGODB_USER_VARIABLES_COLLECTION=scenario_user_variables
MONGODB_FEEDBACK_COLLECTION=scenario_feedback
MONGODB_PROPOSALS_COLLECTION=scenario_proposals
MONGODB_CONVERSATIONS_COLLECTION=conversations
MONGODB_CHAT_MESSAGES_COLLECTION=chat_messages
TELECOM_STANDARDS_CACHE_DIR=./runtime_data/official_standards
OFFICIAL_STANDARDS_MANIFEST=./resources/telecom/standards/official_sources.json
# auto | disabled
OFFICIAL_STANDARDS_SYNC=auto
OFFICIAL_STANDARDS_TIMEOUT_SEC=45
OFFICIAL_STANDARDS_MAX_DOWNLOAD_MB=100
DRAFT_TTL_SECONDS=86400

# HTTP
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# For production, set CORS_ALLOW_ORIGINS to the exact HTTPS frontend origins.
PORT=8000
WEB_CONCURRENCY=1
MAX_CSV_BYTES=10485760

# Schema quality
SCHEMA_MAX_VARIABLES=100
SCHEMA_MIN_VARIABLE_SCORE=42
