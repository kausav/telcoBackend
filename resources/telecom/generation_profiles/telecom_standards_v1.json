{
  "profile": {
    "profile_id": "ingenii-telecom-standards-generation-v1",
    "profile_version": "1.0.0",
    "owner": "INGENII",
    "description": "Deterministic generation overlay for the telecom standards-backed MVP. This file defines generation behavior only; it does not define industry semantics.",
